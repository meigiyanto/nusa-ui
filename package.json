{
  "name": "ui-framework",
  "version": "1.0.0",
  "description": "A complete, modern, responsive UI Framework based on Tailwind CSS v3",
  "main": "src/js/index.js",
  "scripts": {
    "dev": "npx tailwindcss -i ./src/css/tailwind.css -o ./dist/css/framework.css --watch",
    "build": "npx tailwindcss -i ./src/css/tailwind.css -o ./dist/css/framework.css --minify",
    "build:js": "node scripts/build-js.js",
    "build:all": "npm run build && npm run build:js",
    "docs": "npx serve docs",
    "examples": "npx serve public",
    "test": "echo \"See docs/qa-checklist.md for manual QA\" && exit 0"
  },
  "keywords": [
    "ui-framework",
    "tailwindcss",
    "components",
    "design-system",
    "responsive",
    "accessible"
  ],
  "author": "UI Framework Team",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  }
}
