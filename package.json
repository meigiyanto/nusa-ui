{
  "name": "nusa-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable responsive UI component framework built with Tailwind CSS 3",
  "scripts": {
    "dev": "tailwindcss -i ./src/css/app.css -o ./dist/nusa-ui.css --watch",
    "build": "tailwindcss -i ./src/css/app.css -o ./dist/nusa-ui.css --minify"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "tailwindcss": "^3.4.17"
  }
}